  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "server": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "server:build": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outfile=dist/server/index.mjs",
    "server:production": "node dist/server/index.mjs",
    "dev": "concurrently -n api,app -c green,cyan \"npm run server\" \"npm run start\"",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx server/db/run-seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run server:build"
  },
  "private": true
}
