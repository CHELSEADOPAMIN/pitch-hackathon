    "ai": "^7.0.37",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.8",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.9",
