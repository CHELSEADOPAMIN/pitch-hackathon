[Unit]
Description=Aisho Pinch voice shopping API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/work/aisho/pitch-hackathon
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
EnvironmentFile=/home/ubuntu/work/aisho/pitch-hackathon/.env
ExecStart=/usr/local/bin/node apps/server/dist/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
