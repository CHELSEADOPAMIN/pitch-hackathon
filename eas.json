{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_ENABLE_DEMO_CONTROLS": "1"
      },
      "node": "22.16.0",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_ENABLE_DEMO_CONTROLS": "1"
      },
      "node": "22.16.0",
      "android": {
        "buildType": "apk"
      }
    }
  }
}
